NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep false until shared identity/profile/permissions acceptance is complete.
ENABLE_MEMBER_PLATFORM=false
# Enable only after provider, callback allowlist and shared profile checks pass.
ENABLE_GOOGLE_SIGN_IN=false
AUTH_SITE_URL=http://127.0.0.1:3015
# Allowlist this origin's /auth/confirm, /auth/callback and /auth/recovery/callback paths in Supabase Auth.
# Change to the verified HTTPS site origin for a deployed environment.
# Local design review only. Keep false in production.
ENABLE_DESIGN_PREVIEW=false

# Use validation for the pinned isolated account-test environment. Website
# production account integration is blocked in source pending the shared Grow
# permission migration and cross-client verification.
ACCOUNT_ENVIRONMENT=validation
# Work-request intake stays off until isolated SQL and genuine browser acceptance.
# This flag does not authorize staff review or production activation.
ENABLE_WORK_REQUEST_INTAKE=false
ENABLE_PROJECT_CORE=false
# These actions and reads are validation-only until separately reviewed.
ENABLE_LAB_OPENING_VALIDATION=false
ENABLE_OWN_VISITS_VALIDATION=false
