NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep false until shared identity/profile/permissions acceptance is complete.
ENABLE_MEMBER_PLATFORM=false
# Enable only after provider, callback allowlist and shared profile checks pass.
ENABLE_GOOGLE_SIGN_IN=false
AUTH_SITE_URL=http://127.0.0.1:3015
# Allowlist this origin's /auth/callback and /auth/recovery/callback paths in Supabase Auth.
# Change to the verified HTTPS site origin for a deployed environment.
# Local design review only. Keep false in production.
ENABLE_DESIGN_PREVIEW=false
